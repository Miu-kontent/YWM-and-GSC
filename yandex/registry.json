                        "summaryRows": [
                            {"key": "Всего сайтов", "depends": "always"},
                            {"key": "Не подтверждено", "depends": "always"},
                            {"key": "С зеркалами", "depends": "always"},
                            {"key": "Не индексируются", "depends": "status"},
                            {"key": "С рекомендациями", "depends": "problems"},
                            {"key": "С ошибками", "depends": "problems"},
                            {"key": "Без правильного сайтмапа", "depends": "sitemaps"},
                            {"key": "С неправильными сайтмапами", "depends": "sitemaps"},
                            {"key": "Сайтмапы с плохим статусом", "depends": "sitemaps"}
