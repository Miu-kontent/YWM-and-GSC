{
    "categories": [
        {
            "id": "export",
            "name": "Выгрузка",
            "description": "Выгрузка данных из сервисов",
            "subcategories": [
                {
                    "id": "yandex_export",
                    "name": "Выгрузка из Вебмастера",
                    "description": "Выгрузка данных по сайтам: статусы, сайтмапы, проблемы",
                    "script": "yandex_export",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Ссылки"}
