{
    "categories": [
        {
            "id": "export",
            "name": "Выгрузка",
            "description": "Выгрузка данных из Яндекс.Вебмастера",
            "subcategories": [
                {
                    "id": "yandex_export",
                    "name": "Экспорт данных",
                    "description": "Выгрузка данных по сайтам: статусы, сайтмапы, проблемы",
                    "script": "yandex_export",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Ссылки"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Быстрая сводка",
                        "exportGroups": [
                            {"key": "status", "label": "Статус", "tooltip": "Статус сайта (host_data_status) из /hosts/{host-id}. Доп. 1 запрос на сайт"},
                            {"key": "sitemaps", "label": "Сайтмапы", "tooltip": "Пути и статусы сайтмап. +2 запроса на сайт"},
                            {"key": "problems", "label": "Проверки", "tooltip": "Рекомендации, Ошибки. +1 запрос на сайт"}
                        ],
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "200px"},
                            {"depends": "always", "label": "Права", "width": "90px", "center": true},
                            {"depends": "status", "label": "Статус", "width": "90px", "center": true},
                            {"depends": "always", "label": "Зеркала", "width": "140px"},
                            {"depends": "sitemaps", "label": "Сайтмапы", "width": "130px"},
                            {"depends": "problems", "label": "Рекоменд.", "width": "90px", "center": true},
                            {"depends": "problems", "label": "Ошибки", "width": "70px", "center": true}
                        ],
                        "summaryRows": [
                            {"key": "Всего сайтов", "depends": "always"},
                            {"key": "Не подтверждено", "depends": "always"},
                            {"key": "С зеркалами", "depends": "always"},
                            {"key": "Не OK (host_data_status)", "depends": "status"},
                            {"key": "С рекомендациями", "depends": "problems"},
                            {"key": "С ошибками", "depends": "problems"},
                            {"key": "Без правильного сайтмапа", "depends": "sitemaps"},
                            {"key": "С неправильными сайтмапами", "depends": "sitemaps"},
                            {"key": "Сайтмапы не в OK", "depends": "sitemaps"}
                        ]
                    }
                }
            ]
        },
        {
            "id": "sites",
            "name": "Сайты",
            "description": "Управление сайтами: добавление, подтверждение, удаление",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Добавление нового сайта в Яндекс.Вебмастер через API",
                    "script": "yandex_add_sites",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для добавления (по одному на строку)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты добавления",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Всего в списке", "depends": "always"},
                            {"key": "Добавлено", "depends": "always"},
                            {"key": "Уже существовало", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "verify",
                    "name": "Подтверждение",
                    "description": "Подтверждение права собственности на сайт через API (META_TAG → HTML_FILE → DNS)",
                    "script": "yandex_verify",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для подтверждения (по одному на строку)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты подтверждения",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Всего", "depends": "always"},
                            {"key": "Уже подтверждены", "depends": "always"},
                            {"key": "Подтверждено", "depends": "always"},
                            {"key": "  через META_TAG", "depends": "always"},
                            {"key": "  через HTML_FILE", "depends": "always"},
                            {"key": "  через DNS", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "delete",
                    "name": "Удаление",
                    "description": "Удаление сайтов из Яндекс.Вебмастера через API",
                    "script": "yandex_sites_to_delete",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для удаления (по одному на строку)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты удаления",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "200px"}
                        ],
                        "summaryRows": [
                            {"key": "Всего", "depends": "always"},
                            {"key": "Удалено", "depends": "always"},
                            {"key": "Не найдено", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                }
            ]
        },
        {
            "id": "region",
            "name": "Регион",
            "description": "Управление регионами поддоменов",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Массовое добавление регионов поддоменам",
                    "script": "addRegions",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links", "city", "contactPath"]
                },
                {
                    "id": "check",
                    "name": "Проверка",
                    "description": "Проверка текущего региона поддоменов",
                    "script": "Regi",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links", "city"]
                }
            ]
        },
        {
            "id": "sitemaps",
            "name": "Сайтмапы",
            "description": "Управление sitemap: добавление, переотправка, удаление",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Добавление sitemap в Яндекс.Вебмастер через API",
                    "script": "sitemap",
                    "type": "api",
                    "fields": ["links", "yandexSettings"]
                },
                {
                    "id": "resend",
                    "name": "Переотправка",
                    "description": "Перезапрос sitemap для переобхода",
                    "script": "recrawl",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links", "yandexSettings"]
                },
                {
                    "id": "delete",
                    "name": "Удаление",
                    "description": "Удаление sitemap из Яндекс.Вебмастера",
                    "script": null,
                    "type": "browser",
                    "port": 9229,
                    "fields": []
                }
            ]
        },
        {
            "id": "metrics",
            "name": "Метрика",
            "description": "Яндекс.Метрика: добавление, подключение, проверка счётчиков",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Включение обхода по счётчикам для поддоменов",
                    "script": "addMetrics",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links", "yandexSettings"]
                },
                {
                    "id": "bind",
                    "name": "Подключение",
                    "description": "Привязка поддоменов к счётчику Метрики",
                    "script": "metrika_bind",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["metricCounterId"]
                },
                {
                    "id": "counter",
                    "name": "Проверка счётчика",
                    "description": "Проверка обхода счётчиков Метрики",
                    "script": "metriks",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links", "metricCounterId"]
                }
            ]
        },
        {
            "id": "checks",
            "name": "Проверки",
            "description": "Проверка ошибок и рекомендаций",
            "subcategories": [
                {
                    "id": "errors",
                    "name": "Ошибки",
                    "description": "Проверка ошибок индексирования",
                    "script": "errors",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links"]
                },
                {
                    "id": "recommendations",
                    "name": "Рекомендации",
                    "description": "Проверка рекомендаций Яндекс.Вебмастера",
                    "script": "recomen",
                    "type": "browser",
                    "port": 9229,
                    "fields": ["links"]
                }
            ]
        },
        {
            "id": "tests",
            "name": "Тесты",
            "description": "Тестовые скрипты",
            "subcategories": [
{
                "id": "yandex_export_test",
                "name": "Экспорт данных (тест)",
                "description": "Получение всей информации через API Яндекс.Вебмастера",
                "script": "yandex_export_test",
                "type": "api",
                "fields": [
                    {"name": "links", "type": "textarea", "label": "Сайты для анализа (по одному на строку, пусто = все)"},
                    {"name": "date_from", "type": "date", "label": "Дата от"},
                    {"name": "date_to", "type": "date", "label": "Дата до"},
                    {"name": "query_indicator", "type": "select", "label": "Показатель запросов", "options": [
                        {"value": "TOTAL_SHOWS", "label": "Показы"},
                        {"value": "TOTAL_CLICKS", "label": "Клики"},
                        {"value": "AVG_SHOW_POSITION", "label": "Средняя позиция показа"},
                        {"value": "AVG_CLICK_POSITION", "label": "Средняя позиция клика"}
                    ]},
                    {"name": "broken_indicator", "type": "select", "label": "Индикатор нераб. ссылок", "options": [
                        {"value": "", "label": "Все"},
                        {"value": "SITE_ERROR", "label": "SITE_ERROR"},
                        {"value": "DISALLOWED_BY_USER", "label": "DISALLOWED_BY_USER"},
                        {"value": "OUTDATED_CONTENT", "label": "OUTDATED_CONTENT"},
                        {"value": "UNREACHABLE", "label": "UNREACHABLE"}
                    ]}
                ]
            },
            {
                "id": "sites_delete_old",
                "name": "Удаление сайтов (старый UI)",
                "description": "Удаление сайтов через UI (Puppeteer) — устарел",
                "script": "yandex_sites_to_delete_old",
                "type": "browser",
                "port": 9229,
                "fields": ["yandex_sites_to_delete"]
            },
            {
                "id": "verification_old",
                "name": "Подтверждение (старый UI)",
                "description": "Подтверждение через UI (Puppeteer) — устарел",
                "script": "yandex_verify_old",
                "type": "browser",
                "port": 9229,
                "fields": ["links", "yandexSettings"]
            }
            ]
        }
    ],
    "excludedScripts": ["loadConfig", "userid", "yandex_auth", "yandex_get_token", "yandex_get_userid", "yandex_sites_to_delete", "yandex_sites_to_delete_old", "yandex_verify_old"]
}
