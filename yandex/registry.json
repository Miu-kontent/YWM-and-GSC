{
    "categories": [
        {
            "id": "export",
            "name": "Выгрузка",
            "description": "Выгрузка данных из сервисов",
            "subcategories": [
                {
                    "id": "yandex_export",
                    "name": "Выгрузка из Вебмастера",
                    "description": "Выгрузка: сайты, статусы, сайтмапы, проблемы",
                    "script": "yandex_export",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для выгрузки(Пусто = все сайты из Вебмастера)"}
