            "subcategories": [
                {
                    "id": "bing_export_test",
                    "name": "Экспорт Bing (тест)",
                    "description": "Bing Webmaster API — все методы чтения",
                    "script": "bing_export_test",
                    "type": "api",
                    "fields": [
                        {
                            "name": "links",
                            "type": "textarea",
                            "label": "Сайты для анализа (Пусто = первые 3 сайта из Bing)"
                        },
                        {
                            "name": "urls",
                            "type": "textarea",
                            "label": "URL для анализа (Пусто = корень сайта)",
                            "placeholder": "Например: https://example.com/page.html"
                        },
                        {
                            "name": "keyword",
                            "type": "text",
                            "label": "Ключевик (Пусто = пропустить блок ключевиков)",
                            "placeholder": "Например: купить рекламу"
                        }
                    ],
                    "layout": {
                        "hideSave": true
                    }
                },
                {
                    "id": "bing_delete_sitemaps_except",
                    "name": "Удаление сайтмапов кроме...",
                    "description": "Удаление всех сайтмапов, КРОМЕ указанных (GetFeeds + RemoveFeed)",
                    "script": "bing_delete_sitemaps_except",
                    "type": "api",
                    "fields": [
                        {
                            "name": "links",
                            "type": "textarea",
                            "label": "Сайты для обработки (обязательно)"
                        },
                        {
                            "name": "keep_sitemaps",
                            "type": "textarea",
                            "label": "Пути сайтмапов для сохранения (не удалять)",
                            "placeholder": "Например:\n/sitemap/\n/sitemap.xml"
