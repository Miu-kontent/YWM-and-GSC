{
    "categories": [
        {
            "id": "export",
            "name": "Выгрузка",
            "description": "Выгрузка данных из Bing Webmaster",
            "subcategories": [
                {
                    "id": "bing_export",
                    "name": "Выгрузка из Bing",
                    "description": "Выгрузка: сайты, права, сайтмапы",
                    "script": "bing_export",
                    "type": "api",
                    "fields": [
                        {
                            "name": "links",
                            "type": "textarea",
                            "label": "Сайты для выгрузки (Пусто = все сайты из Bing)"
                        },
                        {
                            "name": "show_sitemaps",
                            "type": "checkbox",
                            "label": "Сайтмапы"
                        }
                    ],
                    "layout": {
                        "copySites": true,
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Сводка",
                        "summaryPlaceholder": [
                            "Сайтов",
                            "Не подтверждённых",
                            "Сайтмапов",
                            "Без сайтмапа",
                            "Сайтов с ошибкой сайтмапа",
                            "Сайтов в обработке",
                            "Ошибок запросов"
                        ],
                        "columns": [
                            {
                                "depends": "always",
                                "label": "Сайт",
                                "width": "220px"
                            },
                            {
                                "depends": "always",
                                "label": "Права",
                                "width": "150px"
                            },
                            {
                                "depends": "field:show_sitemaps",
                                "label": "Сайтмапы",
                                "width": "280px"
                            },
                            {
                                "depends": "field:show_sitemaps",
                                "label": "Статусы сайтмапов",
                                "width": "160px"
                            }
                        ]
                    }
                }
            ]
        },
