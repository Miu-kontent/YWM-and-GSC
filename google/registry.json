{
    "categories": [
        {
            "id": "export",
            "name": "Выгрузка",
            "description": "Выгрузка данных из Google Search Console",
            "subcategories": [
                {
                    "id": "gsc_export",
                    "name": "Выгрузка по сайтам",
                    "description": "Сайты + права (sites.list), при чекбоксе — сайтмапы (sitemaps.list) и их статусы",
                    "script": "gsc_export",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты (по одному на строку, пусто = все)"},
                        {"name": "show_sitemaps", "type": "checkbox", "label": "Сайтмапы"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Сводка",
                        "summaryPlaceholder": ["Сайтов", "Не подтверждённых", "Без правильного сайтмапа", "С неправильными сайтмапами", "Сайтмапы для переотправки"],
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "220px"},
                            {"depends": "always", "label": "Права", "width": "150px"},
                            {"depends": "field:show_sitemaps", "label": "Сайтмапы", "width": "280px"},
                            {"depends": "field:show_sitemaps", "label": "Статус сайтмапов", "width": "160px"}
                        ],
                        "postActions": [
                            {
                                "id": "to_resend",
                                "label": "↻ Копировать сайты для переотправки",
                                "depends": "field:show_sitemaps",
                                "statusColumn": 3,
                                "statusContains": ["⏳ В обработке", "❌"]
                            }
                        ]
                    }
                }
            ]
        },
        {
            "id": "sites",
            "name": "Сайты",
            "description": "Управление сайтами: добавление, подтверждение, удаление",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Массовое добавление сайтов в Google Search Console через API",
                    "script": "gsc_add_sites",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для добавления (по одному на строку)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты добавления",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайты", "depends": "always"},
                            {"key": "Добавлено", "depends": "always"},
                            {"key": "Подтверждено", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "verify",
                    "name": "Подтверждение",
                    "description": "Подтверждение прав на сайты через Site Verification API (META → FILE)",
                    "script": "gsc_verify",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты (по одному на строку, пусто = все)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты подтверждения",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Подтверждённых ранее", "depends": "always"},
                            {"key": "Подтверждённых", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "delete",
                    "name": "Удаление",
                    "description": "Удаление конкретных сайтов через UI",
                    "script": null,
                    "type": "browser",
                    "port": 9227,
                    "fields": ["gsc_sites_to_delete"]
                },
                {
                    "id": "delete_unverified",
                    "name": "Удаление неподтверждённых",
                    "description": "Удаление только неподтверждённых сайтов",
                    "script": null,
                    "type": "browser",
                    "port": 9227,
                    "fields": ["gsc_sites_to_delete"]
                }
            ]
        },
        {
            "id": "sitemaps",
            "name": "Сайтмапы",
            "description": "Управление sitemap в Google Search Console",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Добавление sitemap для сайтов аккаунта (sitemaps.submit) + проверка состояния. Пусто в links = все сайты",
                    "script": "gsc_add_sitemap",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты (по одному на строку, пусто = все)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты добавления sitemap",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Сайтмап", "width": "270px"},
                            {"depends": "always", "label": "Статус", "width": "200px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Путь сайтмапа", "depends": "always"},
                            {"key": "Успешно", "depends": "always"},
                            {"key": "Для переотправки", "depends": "always"}
                        ],
                        "postActions": [
                            {
                                "id": "to_resend",
                                "label": "↻ Копировать сайты для переотправки",
                                "statusColumn": 2,
                                "excludeStatus": [
                                    "✅ Успешно",
                                    "✅ Добавлен",
                                    "⭐ Добавлен ранее",
                                    "❌ Не добавлен в GSC",
                                    "❌ Не подтверждён"
                                ]
                            }
                        ]
                    }
                },
                {
                    "id": "resend",
                    "name": "Переотправка",
                    "description": "Переотправка sitemap: обычный (submit) или буквальный (удаление + submit)",
                    "script": "gsc_resend_sitemap",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для переотправки (по одному на строку, пусто = все)"},
                        {"name": "mode", "type": "select", "label": "Способ переотправки", "options": [
                            {"value": "submit", "label": "Обычный (только Submit)"},
                            {"value": "delete_and_submit", "label": "Буквальный (Удаление + Submit)"}
                        ]}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты переотправки",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "280px"},
                            {"depends": "always", "label": "Сайтмап", "width": "270px"},
                            {"depends": "always", "label": "Статус", "width": "200px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Режим", "depends": "always"},
                            {"key": "Успешно", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "delete",
                    "name": "Удаление",
                    "description": "Удаление sitemap из GSC (планируется)",
                    "script": null,
                    "type": "api",
                    "fields": []
                }
            ]
        },
        {
            "id": "tests",
            "name": "Тесты",
            "description": "Тестовые скрипты (не из реестра)",
            "subcategories": [
                {
                    "id": "gsc_export_test",
                    "name": "Экспорт данных Google (тест)",
                    "description": "Тестовая выгрузка всех методов GSC: сайты, сайтмапы, аналитика, проверка URL. Пусто в links = первые 3 сайта",
                    "script": "gsc_export_test",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для анализа (по одному на строку, пусто = первые 3)"},
                        {"name": "date_from", "type": "date", "label": "Дата от"},
                        {"name": "date_to", "type": "date", "label": "Дата до"}
                    ]
                },
                {
                    "id": "gsc_sitemap_test",
                    "name": "Проверка сайтмапов (тест)",
                    "description": "Сайтмапы из sitemaps.list: путь, статус, errors, warnings и contents по каждому. Пусто = все сайты",
                    "script": "gsc_sitemap_test",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для анализа (по одному на строку, пусто = все)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Сводка",
                        "summaryPlaceholder": ["Сайтов", "Не подтверждённых", "Сайтмапов", "Сайтов с ошибками", "Сайтов с pending", "Ошибок запросов"],
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "220px"},
                            {"depends": "always", "label": "Сайтмапы", "width": "300px"},
                            {"depends": "always", "label": "Статусы", "width": "140px"},
                            {"depends": "always", "label": "Errors", "width": "80px", "center": true},
                            {"depends": "always", "label": "Warnings", "width": "80px", "center": true},
                            {"depends": "always", "label": "Contents", "width": "200px"}
                        ]
                    }
                }
            ]
        }
    ],
    "excludedScripts": ["loadConfig", "loadGoogleConfig"]
}
