{
    "categories": [
        {
            "id": "export",
            "name": "Выгрузка",
            "description": "Выгрузка данных из Google Search Console",
            "subcategories": [
                {
                    "id": "gsc_export",
                    "name": "Выгрузка из GSC",
                    "description": "Выгрузка: сайты, статусы, права, сайтмапы",
                    "script": "gsc_export",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для выгрузки (Пусто = все сайты из GSC)"},
                        {"name": "show_sitemaps", "type": "checkbox", "label": "Сайтмапы"}
                    ],
                    "layout": {
                        "copySites": true,
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Сводка",
                        "summaryPlaceholder": ["Сайтов", "Не подтверждённых", "Без правильного сайтмапа", "С неправильными сайтмапами", "Сайтмапы для переотправки"],
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "220px"},
                            {"depends": "always", "label": "Права", "width": "150px"},
                            {"depends": "field:show_sitemaps", "label": "Сайтмапы", "width": "280px"},
                            {"depends": "field:show_sitemaps", "label": "Статус сайтмапов", "width": "160px"}
                        ],
                        "postActions": [
                            {
                                "id": "to_resend",
                                "label": "↻ Копировать сайты для переотправки",
                                "depends": "field:show_sitemaps",
                                "statusColumn": 3,
                                "statusContains": ["⏳ В обработке", "❌"]
                            }
                        ]
                    }
                }
            ]
        },
        {
            "id": "sites",
            "name": "Сайты",
            "description": "Управление сайтамив GSC",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Добавление сайтов",
                    "script": "gsc_add_sites",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для добавления (Обязательный блок)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты добавления",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайты", "depends": "always"},
                            {"key": "Добавлено", "depends": "always"},
                            {"key": "Подтверждено", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "verify",
                    "name": "Подтверждение",
                    "description": "Подтверждение прав",
                    "script": "gsc_verify",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для подтверждения (Пусто = все сайты из GSC)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты подтверждения",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Подтверждённых ранее", "depends": "always"},
                            {"key": "Подтверждённых", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "delete",
                    "name": "Удаление",
                    "description": "Удаление сайтов",
                    "script": "gsc_delete_sites",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для удаления (Обязательный блок)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты удаления",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Статус", "width": "250px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Удалено", "depends": "always"},
                            {"key": "Не найдено", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                }
            ]
        },
        {
            "id": "sitemaps",
            "name": "Сайтмапы",
            "description": "Управление sitemap",
            "subcategories": [
                {
                    "id": "add",
                    "name": "Добавление",
                    "description": "Добавление sitemap",
                    "script": "gsc_add_sitemap",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для добавления (Пусто = все сайты из GSC)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты добавления sitemap",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Сайтмап", "width": "270px"},
                            {"depends": "always", "label": "Статус", "width": "200px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Путь сайтмапа", "depends": "always"},
                            {"key": "Успешно", "depends": "always"},
                            {"key": "Для переотправки", "depends": "always"}
                        ],
                        "postActions": [
                            {
                                "id": "to_resend",
                                "label": "↻ Копировать сайты для переотправки",
                                "statusColumn": 2,
                                "excludeStatus": [
                                    "✅ Успешно",
                                    "✅ Добавлен",
                                    "⭐ Добавлен ранее",
                                    "❌ Не добавлен в GSC",
                                    "❌ Не подтверждён"
                                ]
                            }
                        ]
                    }
                },
                {
                    "id": "resend",
                    "name": "Переотправка",
                    "description": "Переотправка sitemap",
                    "script": "gsc_resend_sitemap",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для переотправки (Пусто = все сайты из GSC. Выбрать режим ниже)"},
                        {"name": "mode", "type": "select", "label": "Способ переотправки", "default": "submit", "options": [
                            {"value": "submit", "label": "Переотправка"},
                            {"value": "delete_and_submit", "label": "Удаление + добавление"}
                        ]}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты переотправки",
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "280px"},
                            {"depends": "always", "label": "Сайтмап", "width": "270px"},
                            {"depends": "always", "label": "Статус", "width": "200px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Режим", "depends": "always"},
                            {"key": "Успешно", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                },
                {
                    "id": "delete",
                    "name": "Удаление",
                    "description": "Удаление sitemap",
                    "script": "gsc_delete_sitemap",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для удаления сайтмапа (Пусто = все сайты из GSC)"},
                        {"name": "sitemap_path", "type": "text", "label": "Путь сайтмапа к удалению", "placeholder": "Например: /sitemap/"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Результаты удаления sitemap",
                        "rowFields": ["sitemap_path"],
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "300px"},
                            {"depends": "always", "label": "Сайтмап", "width": "270px"},
                            {"depends": "always", "label": "Статус", "width": "200px"}
                        ],
                        "summaryRows": [
                            {"key": "Сайтов", "depends": "always"},
                            {"key": "Путь сайтмапа", "depends": "always"},
                            {"key": "Удалено", "depends": "always"},
                            {"key": "Не найдено", "depends": "always"},
                            {"key": "Ошибок", "depends": "always"}
                        ]
                    }
                }
            ]
        },
        {
            "id": "tests",
            "name": "Тесты",
            "description": "Тестовые скрипты (не из реестра)",
            "subcategories": [
                {
                    "id": "gsc_export_test",
                    "name": "Экспорт GSC (тест)",
                    "description": "Google Search Console API",
                    "script": "gsc_export_test",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для анализа (Пусто = все сайты из GSC, макс 3)"},
                        {"name": "date_from", "type": "date", "label": "Дата от"},
                        {"name": "date_to", "type": "date", "label": "Дата до"}
                    ],
                    "layout": {
                        "hideSave": true
                    }
                },
                {
                    "id": "gsc_sitemap_test",
                    "name": "Проверка сайтмапов (тест)",
                    "description": "Статусы сайтмапов",
                    "script": "gsc_sitemap_test",
                    "type": "api",
                    "fields": [
                        {"name": "links", "type": "textarea", "label": "Сайты для анализа (Пусто = все сайты из GSC)"}
                    ],
                    "layout": {
                        "hideSave": true,
                        "hideLogs": true,
                        "statusRolling": true,
                        "splitSummary": true,
                        "summaryLabel": "Сводка",
                        "summaryPlaceholder": ["Сайтов", "Не подтверждённых", "Сайтмапов", "Сайтов с ошибками", "Сайтов с pending", "Ошибок запросов"],
                        "columns": [
                            {"depends": "always", "label": "Сайт", "width": "220px"},
                            {"depends": "always", "label": "Сайтмапы", "width": "300px"},
                            {"depends": "always", "label": "Статусы", "width": "140px"},
                            {"depends": "always", "label": "Errors", "width": "80px", "center": true},
                            {"depends": "always", "label": "Warnings", "width": "80px", "center": true},
                            {"depends": "always", "label": "Contents", "width": "200px"}
                        ]
                    }
                }
            ]
        }
    ],
    "excludedScripts": ["gsc_client"]
}
